# Copy to .env and fill in. NEVER commit the real .env.

# --- Required ---
PORT=3006
MONGO_URI=mongodb://localhost:27017/create_resume
SESSION_SECRET=change-me-to-a-long-random-string

# Origin of the frontend SPA (used for CORS + cookie). Dev default below.
CLIENT_ORIGIN=http://localhost:5173

# --- Email (password recovery) — OPTIONAL ---
# Transactional mail via Brevo. Leave BOTH blank in dev: the mailer then LOGS the
# email (reset link included) to this process's console instead of sending, so the
# whole forgot/reset flow works with no account. Set BOTH to actually send.
# BREVO_API_KEY: Brevo dashboard -> SMTP & API -> API keys.
# EMAIL_FROM: a sender address on a domain verified in Brevo, with SPF + DKIM
# published — without that, reset mail lands in spam.
BREVO_API_KEY=
EMAIL_FROM=

# development | production
# In production the app sets a Secure + SameSite=None session cookie and trusts the
# reverse proxy (Cloudflare Tunnel) — so it MUST be served over HTTPS and CLIENT_ORIGIN
# must be the real frontend URL.
NODE_ENV=development
